project_name = "my-app"
domain       = "example.com"
github_repo  = "you/my-app"

vercel_api_token      = ""
supabase_access_token = ""
supabase_org_id       = ""
cloudflare_api_token  = ""
digitalocean_token    = ""

# Optional droplet (off by default)
enable_droplet          = false
digitalocean_ssh_key_id = ""

# SSH on the droplet is closed by default. List your own address ranges to
# open it; never use 0.0.0.0/0 unless you genuinely want world-open SSH.
# digitalocean_ssh_allowed_cidrs = ["203.0.113.4/32"]

# Optional tuning. All have sensible defaults; uncomment to override.
# supabase_region                = "eu-west-2"
# supabase_enable_signup         = true
# supabase_jwt_expiry            = 3600
# supabase_enable_edge_functions = true
# cloudflare_enable_worker       = true
# digitalocean_region            = "lon1"
# digitalocean_size              = "s-1vcpu-1gb"
